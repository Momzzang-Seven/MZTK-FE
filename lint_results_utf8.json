stant/index';\n\n// ?좊땲硫붿씠???쒓컙??0?쇰줈 紐⑦궧\nvi.mock('@constant/location', async () => {\n    const actual = await vi.importActual('@constant/location');\n    return {\n        ...actual,\n        LOCATION_CONSTANTS: {\n            ...(actual as any).LOCATION_CONSTANTS,\n            ANIMATION_DURATION: 0,\n        },\n    };\n});\n\nconst mockNavigate = vi.fn();\n\nvi.mock('react-router-dom', async () => {\n    const actual = await vi.importActual('react-router-dom');\n    return {\n        ...(actual as object),\n        useNavigate: () => mockNavigate,\n        useLocation: () => ({ state: { from: 'verify' } }),\n    };\n});\n\n// Geolocation 紐⑦궧\nconst mockGetCurrentPosition = vi.fn((success) => {\n    if (success) {\n        success({ coords: { latitude: 37.5, longitude: 127.0 } });\n    }\n});\n(global.navigator as any).geolocation = {\n    getCurrentPosition: mockGetCurrentPosition,\n};\n\ndescribe('[?듯빀] Location System - ?깅줉 諛?濡쒕뵫 ?먮쫫', () => {\n    beforeEach(() => {\n        server.use(...locationHandlers);\n        useUserStore.getState().clearUser();\n        vi.clearAllMocks();\n    });\n\n    it('??珥덇린???????꾩튂 紐⑸줉??API濡?議고쉶?섏뿬 Store??諛섏쁺?쒕떎', async () => {\n        const store = useUserStore.getState();\n        await act(async () => {\n            await store.initLocation();\n        });\n        \n        // msw/handlers/location.ts ??mock ?곗씠???뺤씤\n        expect(useUserStore.getState().gymLocation?.address).toBe(\"?쒖슱??媛뺣궓援??뚰뿤?濡?123\");\n        expect(useUserStore.getState().gymLocation?.locationId).toBe(1);\n    });\n\n    it('?꾩튂 ?깅줉 ?섏씠吏?먯꽌 ?깅줉 踰꾪듉 ?대┃ ??API ?몄텧 諛??깃났 泥섎━媛 ?꾨즺?쒕떎', async () => {\n        render(\n            <BrowserRouter>\n                <LocationRegister />\n            </BrowserRouter>\n        );\n\n        await waitFor(() => expect(mockGetCurrentPosition).toHaveBeenCalled());\n\n        const registerBtn = screen.getByRole('button', { name: UI_TEXT.REGISTER_BTN });\n        \n        await act(async () => {\n            fireEvent.click(registerBtn);\n        });\n\n        // Store ?낅뜲?댄듃 ?뺤씤 (msw/handlers/location.ts ?먯꽌 locationId: 1 由ы꽩)\n        await waitFor(() => {\n            const store = useUserStore.getState();\n            expect(store.gymLocation?.locationId).toBe(1);\n        });\n\n        await waitFor(() => {\n            expect(mockNavigate).toHaveBeenCalledWith('/verify');\n        });\n    });\n\n    it('?꾩튂 ??젣 API ?몄텧???먮윭 ?놁씠 ?섑뻾?쒕떎 (Service Layer Check)', async () => {\n        const { locationService } = await import('@services/location');\n        const result = await locationService.deleteLocation(1);\n        expect(result).toBeDefined();\n    });\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\hero9\\projects\\MZTK_FE\\src\\pages\\__tests__\\Logout.integration.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\hero9\\projects\\MZTK_FE\\src\\pages\\__tests__\\Onboarding.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\hero9\\projects\\MZTK_FE\\src\\pages\\__tests__\\RecordAuth.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\hero9\\projects\\MZTK_FE\\src\\pages\\__tests__\\Verify.integration.test.tsx","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":59,"column":22,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":59,"endColumn":25,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[1818,1821],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and sa